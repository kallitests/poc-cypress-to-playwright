# Use the official Playwright image: it bundles the browsers AND their system libraries.
# Its version MUST match @playwright/test in package-lock.json, otherwise the runner looks for browser builds that are not installed.
FROM mcr.microsoft.com/playwright:v1.64.0-noble
# Keep the target suite in a predictable working directory.
WORKDIR /app
# Copy dependency metadata first so the npm layer is cached until the lockfile changes.
COPY playwright-suite/package.json playwright-suite/package-lock.json ./
# Reproducible install from the lockfile (fails if package.json and the lockfile disagree).
RUN npm ci --no-audit --no-fund
# Copy configuration, features, and steps (node_modules and generated files are excluded by .dockerignore).
COPY playwright-suite/ ./
# CI=true enables retries, blob reports and forbidOnly in playwright.config.ts.
ENV CI=true
# Generate BDD tests and run one finite suite; the Kubernetes Job records completion.
CMD ["npm", "test"]
