# Use a Node image because Cypress is installed through npm.
FROM node:25-bookworm
# Install the libraries headless Electron/Chromium needs (GTK, NSS, ALSA) plus Xvfb, which Cypress uses as a virtual display.
RUN apt-get update && apt-get install -y --no-install-recommends libgtk2.0-0 libgtk-3-0 libgbm-dev libnotify-dev libnss3 libxss1 libasound2 libxtst6 xauth xvfb && rm -rf /var/lib/apt/lists/*
# Keep the suite in a predictable working directory.
WORKDIR /app
# Copy dependency metadata first so the npm layer (including the Cypress binary download) is cached.
COPY cypress-suite/package.json cypress-suite/package-lock.json ./
# Reproducible install from the lockfile; also downloads the Cypress binary into the image cache.
RUN npm ci --no-audit --no-fund && npx cypress verify
# Copy only the baseline suite into the image (node_modules excluded by .dockerignore).
COPY cypress-suite/ ./
ENV CI=true
# Run one finite headless test invocation; the Kubernetes Job supplies completion semantics.
CMD ["npm", "test"]
